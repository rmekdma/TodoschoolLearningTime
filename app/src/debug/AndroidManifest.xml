<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <package android:name="com.enuma.todohangeul" />
        <package android:name="com.enuma.todoenglish" />
        <package android:name="com.enuma.todomath" />
    </queries>
    <permission
        android:name="com.example.todoschooltime.debug.permission.READ_MONITOR_DIAGNOSTICS"
        android:protectionLevel="signature" />
    <application
        android:label="@string/app_name"
        tools:replace="android:label"
        android:networkSecurityConfig="@xml/ticket01_network_security_config">
        <provider
            android:name=".LearningMonitorDiagnosticsProvider"
            android:authorities="com.example.todoschooltime.debug.monitor-diagnostics"
            android:exported="true"
            android:permission="com.example.todoschooltime.debug.permission.READ_MONITOR_DIAGNOSTICS" />
        <service
            android:name=".MonitorAccessibilityService"
            android:label="@string/monitor_accessibility_service_name"
            tools:replace="android:label" />
    </application>
</manifest>
