<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="com.example.todoschooltime.debug.permission.READ_NOTIFICATIONS"
        android:protectionLevel="signature" />
    <application
        android:label="@string/app_name"
        tools:replace="android:label"
        android:networkSecurityConfig="@xml/local_test_network_security_config">
        <provider
            android:name=".LearningMonitorNotificationProvider"
            android:authorities="com.example.todoschooltime.debug.notification-observer"
            android:exported="true"
            android:permission="com.example.todoschooltime.debug.permission.READ_NOTIFICATIONS" />
        <service
            android:name=".MonitorAccessibilityService"
            android:label="@string/monitor_accessibility_service_name"
            tools:replace="android:label" />
    </application>
</manifest>
